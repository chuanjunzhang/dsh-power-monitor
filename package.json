{
  "name": "dsh-power-monitor",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Real-time power draw, temperature, fan speed, CPU and memory in the DeepSeek Harness sidebar (Apple Silicon macOS).",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "deepseek",
    "cordis-plugin",
    "macos",
    "power-monitor",
    "wattage",
    "power-draw",
    "system-monitor",
    "smc",
    "fan-speed",
    "temperature",
    "apple-silicon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chuanjunzhang/dsh-power-monitor.git"
  },
  "homepage": "https://github.com/chuanjunzhang/dsh-power-monitor#readme",
  "bugs": {
    "url": "https://github.com/chuanjunzhang/dsh-power-monitor/issues"
  },
  "license": "MIT",
  "author": "chuanjunzhang"
}